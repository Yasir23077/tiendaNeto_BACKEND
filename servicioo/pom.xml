<?xml version="1.0" encoding="UTF-8"?>
<!-- Define dependencias, version de Java y tareas de compilacion del backend. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- Hereda versiones administradas y configuración estándar de Spring Boot. -->
	<parent>
		<!-- Identifica la organización que publica el parent de Spring Boot. -->
		<groupId>org.springframework.boot</groupId>
		<!-- Selecciona el parent que administra plugins y versiones de dependencias. -->
		<artifactId>spring-boot-starter-parent</artifactId>
		<!-- Fija la versión de Spring Boot utilizada por el proyecto. -->
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<!-- Identifica la organización propietaria del backend. -->
	<groupId>com.tiendasneto</groupId>
	<!-- Define el nombre técnico del artefacto Maven. -->
	<artifactId>neto-ventas</artifactId>
	<!-- Indica que esta versión corresponde a un desarrollo en curso. -->
	<version>0.0.1-SNAPSHOT</version>
	<!-- Nombre legible del proyecto en herramientas Maven. -->
	<name>NETO Sistema de Ventas</name>
	<!-- Resume el propósito del backend. -->
	<description>Sistema de registro y consulta de ventas para Tiendas NETO</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<!-- Propiedades globales que usan el compilador y los plugins de Maven. -->
	<properties>
		<!-- Compila el código fuente con la versión 25 de Java. -->
		<java.version>25</java.version>
	</properties>
	<!-- Dependencias necesarias para iniciar la API, seguridad y persistencia. -->
	<dependencies>
		<!-- Habilita la consola web de H2 cuando la configuración la expone. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
		</dependency>
		<!-- Integra JPA y Hibernate para acceder a la base de datos. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Proporciona los controladores REST y el servidor web MVC. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Activa Jakarta Bean Validation para validar los DTO de entrada. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Agrega autenticacion, autorizacion, filtros y proteccion CSRF de Spring Security. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<!-- Activa autenticacion, autorizacion, filtros y proteccion CSRF. -->
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Permite abrir conexiones con MySQL en tiempo de ejecución. -->
		<dependency>
		<groupId>com.mysql</groupId>
		<artifactId>mysql-connector-j</artifactId>
		<scope>runtime</scope>
		</dependency>
		<!-- Provee utilidades de prueba para JPA sin incluirlas en producción. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Provee utilidades de prueba para controladores web MVC. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- Configura el plugin que permite empaquetar y ejecutar Spring Boot. -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
